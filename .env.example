# Copy this file to .env.local and fill in real values to switch the
# "Scripts de Reunião" / "Reuniões" persistence layer from localStorage to
# Supabase. Both are required together — if either is missing, the app
# automatically falls back to localStorage (see src/store/index.ts) and
# keeps working with no crash.
#
# Setup:
#   1. Create a Supabase project.
#   2. Run supabase/schema.sql once against it (SQL Editor, or `supabase db push`).
#   3. Copy the Project URL and anon/public key from Project Settings > API.
#   4. Set them below, in .env.local (never commit real values).
#
# These are read at build time by Vite and end up in the client bundle —
# only ever put the *anon* key here, never a service-role key.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# ABZA Sales Copilot — OpenAI (server-side only)
# ---------------------------------------------------------------------------
# Usada exclusivamente por api/copilot.ts, lida via process.env.OPENAI_API_KEY.
# NUNCA prefixe com VITE_ — isso a colocaria no bundle público do frontend.
# Configure na Vercel em Project Settings > Environment Variables (não em
# .env.local se você também usa `vite dev` com um proxy público; para rodar
# localmente use um .env.local não commitado, ou exporte no shell antes de
# `npm run test:copilot` / `vercel dev`).
#
# OPENAI_MODEL é opcional — se omitida, usa o padrão definido em api/copilot.ts.

OPENAI_API_KEY=
OPENAI_MODEL=
